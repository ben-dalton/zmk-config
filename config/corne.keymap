#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&sk {
        // Default 1s is tight after a double tap; give time to reach the next key
        release-after-ms = <2000>;
};

/ {
        macros {
                // Three separate sticky mods: a single &sk LC(LA(LGUI)) only keeps
                // GUI, since implicit mods are dropped on the next key press
                hyper_once: hyper_once {
                        compatible = "zmk,behavior-macro";
                        display-name = "Ctrl+Opt+Cmd once";
                        #binding-cells = <0>;
                        bindings = <&sk LCTRL &sk LALT &sk LGUI>;
                };
        };

        behaviors {
                // Tap or hold: GUI. Double tap: ctrl+opt+cmd for the next key, for
                // the skhd media shortcuts (Space / Y / O / I / U)
                td_gui: td_gui {
                        compatible = "zmk,behavior-tap-dance";
                        display-name = "GUI / Ctrl+Opt+Cmd";
                        #binding-cells = <0>;
                        tapping-term-ms = <300>;
                        bindings = <&kp LGUI>, <&hyper_once>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// |  ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | RET | LWR | GUI*|   | SPC | RSE  | ALT |
//  * tap/hold GUI, double tap = ctrl+opt+cmd for the next key
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp ESC   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp LSHFT
                     &kp RET &mo 1 &td_gui   &kp SPACE &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |   `  |     |     |  {  |  }  |  =  |   |A+G ←|A+G →| F12 |     |     |  -   |
// |      |BTPRV|BTNXT|  (  |  )  |  >  |   |  ←  |  ↓  |  ↑  |  →  |     |  `   |
// |      | ALT |BTCLR|  [  |  ]  |  <  |   |CSA ←| RET |     |     | ALT | DEL  |
//                    |     |     |     |   |  _  |     |     |
                        display-name = "Lower";
                        bindings = <
   &kp GRAVE &trans      &trans      &kp LBRC &kp RBRC &kp EQUAL   &kp LA(LG(LEFT))     &kp LA(LG(RIGHT)) &kp F12 &trans    &trans   &kp MINUS
   &trans    &bt BT_PRV  &bt BT_NXT  &kp LPAR &kp RPAR &kp GT      &kp LEFT             &kp DOWN          &kp UP  &kp RIGHT &trans   &kp GRAVE
   &trans    &kp LALT    &bt BT_CLR  &kp LBKT &kp RBKT &kp LT      &kp LC(LS(LA(LEFT))) &kp RET           &trans  &trans    &kp RALT &kp DEL
                                     &trans   &trans   &trans      &kp UNDER            &trans            &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  {  |  }  |  =  |   |  =  |  7  |  8  |  9  |  0  | BKSP |
// |      |BTPRV|BTNXT|  (  |  )  |  >  |   |  +  |  4  |  5  |  6  |  =  |  `   |
// | SHFT |     |BTCLR|  [  |  ]  |  <  |   |  -  |  1  |  2  |  3  |  \  | SHFT |
//                    |     |     |     |   |  _  |     |     |
                        display-name = "Raise";
                        bindings = <
   &kp TAB   &kp N1      &kp N2      &kp LBRC &kp RBRC &kp EQUAL   &kp EQUAL &kp N7 &kp N8 &kp N9 &kp N0    &kp BSPC
   &trans    &bt BT_PRV  &bt BT_NXT  &kp LPAR &kp RPAR &kp GT      &kp PLUS  &kp N4 &kp N5 &kp N6 &kp EQUAL &kp GRAVE
   &kp LSHFT &trans      &bt BT_CLR  &kp LBKT &kp RBKT &kp LT      &kp MINUS &kp N1 &kp N2 &kp N3 &kp BSLH  &kp LSHFT
                                     &trans   &trans   &trans      &kp UNDER &trans &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
